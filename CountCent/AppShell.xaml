<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CountCent.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CountCent"
    Title="CountCent">

    <TabBar>
        <Tab Title="Home" SemanticProperties.Description="Main page">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="Analysis" SemanticProperties.Description="Analysis view">
            <ShellContent
                Title="Analysis"
                ContentTemplate="{DataTemplate local:AnalysisPage}"
                Route="AnalysisPage" />
        </Tab>
    </TabBar>
</Shell>
